# ===== LLM =====
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding =====
# 可填 HuggingFace 模型 id（如 BAAI/bge-small-zh-v1.5，首次运行会联网下载），
# 也可填本地模型目录（离线可用），例如：
#   EMBEDDING_MODEL=./data/models/models/BAAI--bge-small-zh-v1.5/snapshots/master
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== Vector Store =====
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/vector_store

# ===== Application =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== RAG =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# ===== 混合检索（向量 + BM25，RRF 融合）=====
HYBRID_ENABLED=true
RETRIEVE_CANDIDATES=20
RRF_K=60

# ===== 重排序（Rerank）=====
# 两段式检索：先粗召回 RERANK_CANDIDATES 个候选，再用交叉编码器精排取 TOP_K。
# 需要额外下载模型（约 1GB）；模型不可用时自动降级为不重排，不影响服务可用性。
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=10
RERANK_DEVICE=cpu

# ===== 检索结果缓存 =====
CACHE_ENABLED=true
CACHE_SIZE=256
CACHE_TTL=300

# ===== 流式回答 =====
# 首字超时（秒）：超时未吐字则重试；<=0 表示不限制
LLM_FIRST_TOKEN_TIMEOUT=20