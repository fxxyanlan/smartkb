# ===== LLM =====
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding =====
# 可填 HuggingFace 模型 id（如 BAAI/bge-small-zh-v1.5，首次运行会联网下载），
# 也可填本地模型目录（离线可用），例如：
#   EMBEDDING_MODEL=./data/models/models/BAAI--bge-small-zh-v1.5/snapshots/master
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== Vector Store =====
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/vector_store

# ===== Application =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== RAG =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4